# Configure secrets only in your deployment environment or an ignored .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
PORT=3000
DB_PATH=./data/office.sqlite
DAILY_AI_CALL_LIMIT=30
# Required with NODE_ENV=production; exact public HTTPS origin, no trailing slash.
APP_ORIGIN=

# Stable 32-byte base64 key, provision securely; required for workspace BYOK and MFA.
WORKSPACE_SECRET_KEY=
DATABASE_BACKUPS=false

# Transactional email: verify your sending domain in Resend first.
RESEND_API_KEY=
MAIL_FROM=
# Turn on only after delivery/verification has been tested.
EMAIL_VERIFICATION_REQUIRED=false

# QPay merchant: sandbox and production credentials are different.
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
# Example SHAPE only: define your actual approved prices before accepting payments.
BILLING_PLANS_JSON=[]
# Each plan: {"id":"team","name":"Team","amount":<MNT integer>,"days":30,"dailyCalls":100}
# Enable after sandbox and production callbacks are verified.
BILLING_ENFORCE=false

# OAuth apps: configure exact redirects listed in docs/OPERATIONS.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Encrypted backup to a separate S3-compatible object store.
# Preserve BOTH backup encryption key and workspace secret key outside this service.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PATH_STYLE=false
BACKUP_S3_PREFIX=rainy-office
BACKUP_ENCRYPTION_KEY=
