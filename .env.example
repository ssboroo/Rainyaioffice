# Configure secrets only in your deployment environment or an ignored .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
PORT=3000
DB_PATH=./data/office.sqlite
DAILY_AI_CALL_LIMIT=30
# Required with NODE_ENV=production; exact public HTTPS origin, no trailing slash.
APP_ORIGIN=

# Stable 32-byte base64 key, provision securely; required for workspace BYOK and MFA.
WORKSPACE_SECRET_KEY=
DATABASE_BACKUPS=false
